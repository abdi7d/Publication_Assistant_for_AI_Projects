# Example environment variables for production deployment
APP_ENV=production
DEBUG=false

# Secrets - set strong values in production
JWT_SECRET=replace_with_a_strong_secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_SECONDS=3600

# Optional Redis for rate limiting and caching
REDIS_URL=redis://localhost:6379/0

# Limits
MAX_PROMPT_LENGTH=5000
MAX_UPLOAD_BYTES=10485760
RATE_LIMIT_PER_MINUTE=60
RATE_LIMIT_BURST=20
# Example .env for secure configcontinue
APP_ENV=production
SECRET_KEY=replace_with_secure_random_value
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7
REDIS_URL=redis://localhost:6379/0
LOG_DIR=logs
LOG_LEVEL=INFO
MODEL_API_KEY=
DATABASE_URL=postgresql://user:pass@localhost:5432/appdb
GOOGLE_API_KEY=your_google_api_key
GROQ_API_KEY=your_groq_api_key
TAVILY_API_KEY=your_tavily_key
GITHUB_TOKEN=your_github_personal_access_token_here  # For repo access 
SERPAPI_API_KEY=your_serpapi_key_here  # For web search 
# Resilience and monitoring 
PROMETHEUS_PORT=8000
PROMETHEUS_METRICS_PATH=/metrics
OPENTELEMETRY_ENABLED=false
OTEL_EXPORTER_OTLP_ENDPOINT=
SENTRY_DSN=

# Alerting
SLACK_WEBHOOK_URL=
ALERT_EMAIL=

# Circuit breaker defaults
CIRCUIT_FAILURE_THRESHOLD=5
CIRCUIT_RECOVERY_TIMEOUT_SECONDS=60

# Retry and backoff defaults
RETRY_MAX_ATTEMPTS=5
RETRY_BASE_DELAY=0.5
RETRY_MAX_DELAY=30
RETRY_JITTER=true

# Timeout defaults (seconds)
LLM_TIMEOUT_SECONDS=30
TOOL_TIMEOUT_SECONDS=10
WORKFLOW_STEP_TIMEOUT_SECONDS=60

# Concurrency
MAX_CONCURRENT_WORKFLOWS=10
WORKER_QUEUE_SIZE=100
