# Example environment variables for production deployment
# SECURITY WARNING: Never commit actual secrets to version control
# Use strong, randomly generated values in production

# Application Configuration
APP_ENV=production
DEBUG=false

# secrets - REQUIRED for production
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
JWT_SECRET=
SECRET_KEY=

# JWT Configuration
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_SECONDS=3600
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# API Keys - Required for functionality
GOOGLE_API_KEY=
GROQ_API_KEY=
TAVILY_API_KEY=
GITHUB_TOKEN=
SERPAPI_API_KEY=
MODEL_API_KEY=

# Database Configuration
DATABASE_URL=postgresql://user:pass@localhost:5432/appdb

# Optional Redis for rate limiting and caching
REDIS_URL=redis://localhost:6379/0

# Logging Configuration
LOG_DIR=logs
LOG_LEVEL=INFO

# Security Limits
MAX_PROMPT_LENGTH=5000
MAX_UPLOAD_BYTES=10485760
RATE_LIMIT_PER_MINUTE=60
RATE_LIMIT_BURST=20

# Monitoring and Observability
PROMETHEUS_PORT=8001
PROMETHEUS_METRICS_PATH=/metrics
OPENTELEMETRY_ENABLED=false
OTEL_EXPORTER_OTLP_ENDPOINT=
SENTRY_DSN=

# Alerting
SLACK_WEBHOOK_URL=
ALERT_EMAIL=

# Resilience Configuration
CIRCUIT_FAILURE_THRESHOLD=5
CIRCUIT_RECOVERY_TIMEOUT_SECONDS=60
RETRY_MAX_ATTEMPTS=5
RETRY_BASE_DELAY=0.5
RETRY_MAX_DELAY=30
RETRY_JITTER=true

# Timeout Configuration (seconds)
LLM_TIMEOUT_SECONDS=30
TOOL_TIMEOUT_SECONDS=10
WORKFLOW_STEP_TIMEOUT_SECONDS=60

# Concurrency Limits
MAX_CONCURRENT_WORKFLOWS=10
WORKER_QUEUE_SIZE=100
